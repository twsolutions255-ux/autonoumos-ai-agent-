# ---------------------------------------------------------------------------
# Atlas — TWS autonomous scaling agent
#
# Every variable below gates something real. Nothing here fakes a capability:
# if a key is missing, Atlas reports that feature as OFF on /health and in the
# console, rather than quietly doing nothing.
# ---------------------------------------------------------------------------

# --- Reasoning (required) --------------------------------------------------
# Without this Atlas cannot think and every cycle no-ops.
ANTHROPIC_API_KEY=
ATLAS_MODEL=claude-opus-5
ATLAS_FAST_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max. Higher = better decisions, more cost.
ATLAS_EFFORT=high

# --- The app Atlas runs (required) -----------------------------------------
# Atlas must be a SUPERADMIN. The TWS app has no endpoint that can create one:
# the account is seeded from the app's own SUPERADMIN_EMAIL/PASSWORD at
# startup. Either give Atlas those credentials, or add a second superadmin by
# seeding it on the app side. A non-superadmin Atlas can read and chat but
# cannot run the business, and /status will say so.
TWS_API_URL=https://tws-backend.onrender.com
TWS_EMAIL=
TWS_PASSWORD=

# Optional. Lets Atlas run the app's five scheduled jobs on demand — most
# usefully draining speed-to-lead the moment a lead arrives. Must equal the
# app's INTERNAL_CRON_SECRET. Unset simply means it cannot.
TWS_CRON_SECRET=

# --- Memory (required) -----------------------------------------------------
# The same MongoDB the app uses. Atlas keeps its own atlas_* collections and
# never writes to the app's; all changes go through the HTTP API so the app's
# own validation and webhooks still fire.
MONGO_URL=
ATLAS_DB_NAME=tws
ATLAS_COLLECTION_PREFIX=atlas_

# --- Console (required) ----------------------------------------------------
# The control API can start cold calls, so it is never open. Unset means it
# refuses to serve at all rather than serving everybody.
ATLAS_CONSOLE_API_KEY=
ATLAS_CORS_ORIGINS=https://tws-solutions.vercel.app

# --- Authority -------------------------------------------------------------
# observe    look, change nothing, say nothing
# recommend  look, plan, brief the owner                    <- default
# assist     + talk to the team and AI employees, queue work
# operate    + run the acquisition pipeline end to end
# autopilot  + money-adjacent and irreversible actions
ATLAS_AUTONOMY=recommend

# While true, nothing reaches the outside world: no calls, no staged batches,
# no money actions. Atlas still reads, reasons, plans and briefs — so you can
# judge its decisions from the record before trusting it. Turn off deliberately.
ATLAS_SANDBOX=true

# The brake. Checked before every single tool call, so flipping it takes effect
# inside a running cycle.
ATLAS_KILL_SWITCH=false

# --- Limits ----------------------------------------------------------------
ATLAS_DAILY_LLM_BUDGET_USD=25
ATLAS_MAX_OUTREACH_PER_HOUR=40
ATLAS_MAX_CALLS_STAGED_PER_DAY=200
ATLAS_MAX_CHAT_PER_HOUR=30
# Any single action estimated at or above this always goes to the owner,
# at every autonomy level including autopilot.
ATLAS_APPROVAL_THRESHOLD_USD=250
ATLAS_MAX_TOOL_ITERATIONS=40

# --- Cadence ---------------------------------------------------------------
ATLAS_TICK_SECONDS=900
ATLAS_MORNING_HOUR=7
ATLAS_EVENING_HOUR=19
ATLAS_TIMEZONE=America/New_York

ATLAS_LOG_LEVEL=INFO
